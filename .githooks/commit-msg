#!/usr/bin/env sh
set -eu

COMMIT_MSG_FILE="$1"
FIRST_LINE="$(sed -n '1p' "$COMMIT_MSG_FILE")"

case "$FIRST_LINE" in
  feat:\ *|fix:\ *|docs:\ *|chore:\ *|refactor:\ *|test:\ *|ops:\ *|data:\ *)
    exit 0
    ;;
  *)
    echo "Commit message must use Conventional Commits."
    echo "Allowed types: feat, fix, docs, chore, refactor, test, ops, data."
    echo "Received: $FIRST_LINE"
    exit 1
    ;;
esac
