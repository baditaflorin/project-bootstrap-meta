#!/usr/bin/env sh
zero="0000000000000000000000000000000000000000"
_skip_full=true
while read -r _local_ref _local_oid _remote_ref _remote_oid; do
  if [ "$_remote_oid" = "$zero" ] || [ "$_local_oid" = "$zero" ]; then
    _skip_full=false
    continue
  fi
  _changed="$(git diff --name-only "$_remote_oid" "$_local_oid" 2>/dev/null || true)"
  if [ -n "$_changed" ] && printf '%s\n' "$_changed" | grep -qvE '^(CLAUDE\.md|\.githooks/.*)$'; then
    _skip_full=false
  fi
done
if [ "$_skip_full" = true ]; then
  exit 0
fi
set -eu

make test
make build

if [ ! -s docs/index.html ]; then
  echo "docs/index.html is missing or empty after build."
  exit 1
fi

if ! grep -q '<div id="root"></div>' docs/index.html; then
  echo "docs/index.html does not look like the Vite app shell."
  exit 1
fi

make smoke
